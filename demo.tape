Output demo.gif
Set FontSize 16
Set Width 1180
Set Height 560
Set Padding 0
Set Framerate 30
Env APPDATA "C:\Users\natha\AppData\Local\Temp\wowfix-demo-config"
Set TypingSpeed 40ms
Sleep 800ms
Type "wowfix.exe"
Enter
Sleep 2.5s
Down
Sleep 400ms
Down
Sleep 400ms
Type "f"
Sleep 500ms
Type "y"
Sleep 2s
Type "r"
Sleep 1.5s
Type "c"
Sleep 800ms
Type "/"
Sleep 300ms
Type "elvui"
Sleep 5s
Escape
Sleep 300ms
Escape
Sleep 300ms
Type "?"
Sleep 1s
Escape
Sleep 300ms
Type "q"
Sleep 300ms
